{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Pico Debug Probe",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/docsbc_db.elf",
      "request": "launch",
      "type": "cortex-debug",
      "servertype": "openocd",
      "gdbPath": "${env:ARM_GDB_PATH}",
      "showDevDebugOutput": "raw",
      "device": "RP2040",
      "configFiles": [
        "interface/cmsis-dap.cfg",
        "target/rp2040.cfg"
      ],
      "svdFile": "${env:PICO_SDK_PATH}/src/rp2040/hardware_regs/rp2040.svd",
      "runToEntryPoint": "main",
      "openOCDLaunchCommands": [
        "adapter speed 500"
      ]
    },
    {
      "name": "Pico2 (RP2350) Debug",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/docsbc_db.elf",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "gdbPath": "${env:ARM_GDB_PATH}",
      "showDevDebugOutput": "raw",
      "device": "RP2350",
      "targetProcessor": 0,
    "configFiles": [
        "interface/cmsis-dap.cfg",
        "target/rp2350.cfg"
      ],
      "svdFile": "${env:PICO_SDK_PATH}/src/rp2350/hardware_regs/rp2350.svd",
      "runToEntryPoint": "main",
      "openOCDLaunchCommands": [
        "adapter speed 500"
      ]
    },
    {
      "name": "Pico DP - CMake Target",
      "cwd": "${workspaceFolder}",
      "executable": "${command:cmake.launchTargetPath}",
      "request": "launch",
      "type": "cortex-debug",
      "servertype": "openocd",
      "gdbPath": "${env:ARM_GDB_PATH}",
      "showDevDebugOutput": "raw",
      "device": "RP2040",
      "configFiles": [
        "interface/cmsis-dap.cfg",
        "target/rp2040.cfg"
      ],
      "svdFile": "${env:PICO_SDK_PATH}/src/rp2040/hardware_regs/rp2040.svd",
      "runToEntryPoint": "main",
      "openOCDLaunchCommands": [
        "adapter speed 1000"
      ]
    },
    {
      "name": "Pico Debug (Cortex-Debug with external OpenOCD)",
      "cwd": "${workspaceFolder}",
      "executable": "${command:cmake.launchTargetPath}",
      "request": "launch",
      "type": "cortex-debug",
      "servertype": "external",
      "gdbTarget": "localhost:3333",
      "gdbPath": "${env:ARM_GDB_PATH}",
      "device": "RP2040",
      "svdFile": "${env:PICO_SDK_PATH}/src/rp2040/hardware_regs/rp2040.svd",
      "runToEntryPoint": "main"
    }
  ]
}